<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 12+ requires ACCESS_COARSE_LOCATION declared alongside ACCESS_FINE_LOCATION even
         though this app only ever requests/relies on FINE - the OS lets the user grant approximate-
         only at the system dialog regardless, and the app treats that the same as denied (§2.3:
         fine location is required to go online). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34) requires a type-matching permission alongside foregroundServiceType -
         install-time/auto-granted, but its absence blocks the service from starting at all on 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+ (API 33) runtime permission for the service's persistent notification. Denial
         does not stop the service or its location updates - only the notification itself (§2.3). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LadyGoDriverApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LadyGo"
        android:usesCleartextTraffic="false">
        <!-- False positive: this is the app's MAIN/LAUNCHER activity, not a general exported
             component - Android REQUIRES exported="true" here (API 31+ build-fails without it for
             any activity with a MAIN/LAUNCHER intent-filter), and it accepts no deep-link data, no
             custom scheme, reads no Intent extras - there is no attacker-controlled surface for
             another app to drive into a state it doesn't already start in (confirmed in this app's
             own security review, docs/product/driver-android-design.md slice 1). See
             docs/security/sast-triage.md. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LadyGo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".location.LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
